Options -Indexes
RewriteEngine On
RewriteBase /

# Public page aliases
RewriteRule ^inicio/?$ index.html [L]
RewriteRule ^loja/?$ shop.html [L]
RewriteRule ^sobre/?$ about.html [L]
RewriteRule ^contactos/?$ contact.html [L]
RewriteRule ^workshops/?$ workshops.html [L]
RewriteRule ^curiosidades/?$ curiosidades.html [L]
RewriteRule ^comunidade/?$ comunidade.html [L]
RewriteRule ^apicultores/?$ apicultores.html [L]

# Keep existing files and folders untouched
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Allow access to html pages without extension
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Basic hardening
<FilesMatch "^(\.env|\.git|package-lock\.json|package\.json)$">
  Require all denied
</FilesMatch>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
